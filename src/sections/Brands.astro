---
import { Image } from 'astro:assets';
import baldwin from '@/assets/marcas/baldwin-filters.png';
import cummins from '@/assets/marcas/cummins.svg';
import donaldson from '@/assets/marcas/donaldson.png';
import fgWilson from '@/assets/marcas/fg-wilson.png';
import fleetguard from '@/assets/marcas/fleetguard.png';
import komatsu from '@/assets/marcas/komatsu.svg';
import mannFilter from '@/assets/marcas/mann-filter.png';
import mobil from '@/assets/marcas/mobil.svg';
import perkins from '@/assets/marcas/perkins.svg';
import valvoline from '@/assets/marcas/valvoline.svg';
import SectionTitle from '@/components/SectionTitle.astro';
import { getSite } from '@/lib/site';

const { marcas } = await getSite();
const logos: Record<string, ImageMetadata> = {
  Donaldson: donaldson,
  Baldwin: baldwin,
  Perkins: perkins,
  Cummins: cummins,
  'FG Wilson': fgWilson,
  Fleetguard: fleetguard,
  Mobil: mobil,
  'Mann Filter': mannFilter,
  Valvoline: valvoline,
  Komatsu: komatsu,
};
const items = marcas.items.map((nombre) => ({ nombre, logo: logos[nombre] }));
---

<section aria-labelledby="marcas-titulo" class="border-t border-border py-14 md:py-16">
  <div class="mx-auto mb-10 max-w-7xl px-5 md:mb-12 md:px-10">
    <div class="reveal">
      <SectionTitle
        antetitulo={marcas.antetitulo}
        titulo={marcas.titulo}
        id="marcas-titulo"
        centrado
        class="mx-auto max-w-[32ch] text-[clamp(1.75rem,1.8vw+1.1rem,2.75rem)] leading-[1.05]"
      />
    </div>
  </div>
  <!-- Lista accesible -->
  <ul class="sr-only">
    {items.map((m) => <li>{m.nombre}</li>)}
  </ul>
  <!-- Cinta visual -->
  <div class="marquee overflow-hidden" aria-hidden="true">
    <div class="marquee-track flex w-max py-4">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center gap-5 pr-5">
            {items.map((m) => (
              <li class="brand-card flex h-20 w-44 items-center justify-center rounded-xl bg-white ring-1 ring-border">
                {m.logo ? (
                  <Image src={m.logo} alt="" class="max-h-10 max-w-32 w-auto object-contain" />
                ) : (
                  <span class="text-2xl font-semibold tracking-tight text-steel">{m.nombre}</span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
