---
import { Image } from 'astro:assets';
import { Cable, Droplets, Factory, PencilRuler, Unplug, Wind } from 'lucide-react';
import accesorios from '@/assets/products/accesorios-hidraulicos.jpg';
import filtroAcero from '@/assets/products/filtro-acero-perforado.jpg';
import filtroMalla from '@/assets/products/filtro-malla-metalica.jpg';
import conicos from '@/assets/products/filtros-conicos.jpg';
import flexibles from '@/assets/products/flexibles-hidraulicos.jpg';
import separadores from '@/assets/products/separadores-aire-aceite.jpg';
import { getSite } from '@/lib/site';

const { servicios } = await getSite();
const iconosServicio = {
  gota: Droplets,
  viento: Wind,
  fabrica: Factory,
  regla: PencilRuler,
  flexible: Cable,
  conexion: Unplug,
};
const fotos = [filtroAcero, filtroMalla, conicos, separadores, flexibles, accesorios];
const productos = servicios.galeria.items.map((item, i) => ({ ...item, foto: fotos[i] }));
---

<section id="servicios" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 md:px-10 md:py-28">
  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <h2 class="display text-h2">{servicios.titulo}</h2>
    <p class="max-w-[46ch] text-lg leading-relaxed text-muted">{servicios.bajada}</p>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
    {
      servicios.items.map((item, i) => {
        const Icono = iconosServicio[item.icono];
        const propia = item.como === 'Fabricación propia';
        return (
          <li class="reveal">
            <article class="group relative flex h-full flex-col overflow-clip rounded-2xl border border-border bg-surface p-7 transition-all duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:border-brand/50 hover:shadow-xl hover:shadow-ink/10 md:p-8">
              <span
                aria-hidden="true"
                class="absolute right-6 top-5 font-serif text-5xl italic leading-none text-steel/25 transition-colors duration-500 group-hover:text-brand/35"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span
                aria-hidden="true"
                class="mb-6 flex size-14 items-center justify-center rounded-2xl bg-brand/10 text-accent ring-1 ring-brand/20 transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:bg-accent group-hover:text-on-accent group-hover:ring-accent"
              >
                <Icono size={26} strokeWidth={1.6} className="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-rotate-6" />
              </span>
              <h3 class="max-w-[16ch] text-xl font-semibold leading-snug tracking-tight md:text-[1.35rem]">
                {item.sistema}
              </h3>
              <p class="mt-3 leading-relaxed text-muted">{item.asegura}</p>
              <p class="mt-auto pt-7">
                <span
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-medium',
                    propia ? 'bg-brand/10 text-accent ring-1 ring-brand/25' : 'text-muted ring-1 ring-border',
                  ]}
                >
                  {propia && <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />}
                  {item.como}
                </span>
              </p>
            </article>
          </li>
        );
      })
    }
  </ul>

  <div class="reveal mt-16 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-2 md:mt-20">
    <h3 class="display text-2xl font-semibold tracking-tight md:text-3xl">{servicios.galeria.titulo}</h3>
    <p class="text-sm text-muted">{servicios.galeria.nota}</p>
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-3">
    {
      productos.map((producto) => (
        <li class="reveal">
          <figure class="group m-0">
            <div class="overflow-clip rounded-lg border border-border bg-surface">
              <Image
                src={producto.foto}
                alt={producto.alt}
                width={720}
                class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-3 text-sm font-medium text-muted">{producto.titulo}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
