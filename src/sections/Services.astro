---
import { getSite } from '@/lib/site';

const { servicios } = await getSite();
---

<section id="servicios" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 md:px-10 md:py-28">
  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <h2 class="display text-h2">{servicios.titulo}</h2>
    <p class="max-w-[46ch] text-lg leading-relaxed text-muted">{servicios.bajada}</p>
  </div>

  <div class="reveal overflow-x-auto rounded-lg border border-border bg-surface">
    <table class="w-full border-collapse text-base sm:min-w-[40rem]">
      <thead class="max-sm:sr-only">
        <tr class="bg-ink text-left text-white">
          {
            servicios.columnas.map((col) => (
              <th scope="col" class="px-6 py-4 font-semibold [font-stretch:90%]">
                {col}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          servicios.items.map((item) => (
            <tr class="group border-t border-border transition-colors duration-300 first:border-t-0 hover:bg-bg max-sm:flex max-sm:flex-col max-sm:gap-1 max-sm:px-5 max-sm:py-5 sm:first:border-t">
              <th scope="row" class="text-left text-xl font-bold sm:px-6 sm:py-6">
                <span class="inline-flex items-center gap-3">
                  <span
                    aria-hidden="true"
                    class="h-5 w-1 origin-bottom scale-y-0 max-sm:hidden rounded-full bg-brand transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100"
                  />
                  {item.sistema}
                </span>
              </th>
              <td class="text-muted sm:px-6 sm:py-6">{item.asegura}</td>
              <td class="text-sm text-muted sm:px-6 sm:py-6 sm:text-base">{item.como}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
