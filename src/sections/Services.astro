---
import { Image, Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import filtroAcero from '@/assets/products/filtro-acero-perforado.jpg';
import filtroMalla from '@/assets/products/filtro-malla-metalica.jpg';
import fondoAccesorios from '@/assets/servicios/accesorios-hidraulicos.jpg';
import fondoFlexibles from '@/assets/servicios/flexibles-hidraulicos.jpg';
import fotoInvitacion from '@/assets/servicios/operario-control-planta.jpg';
import fondoProcesos from '@/assets/servicios/procesos-industriales.jpg';
import fondoProyectos from '@/assets/servicios/proyectos-especiales.jpg';
import fondoHidraulico from '@/assets/servicios/sistema-hidraulico.jpg';
import fondoNeumatico from '@/assets/servicios/sistema-neumatico.jpg';
import SectionTitle from '@/components/SectionTitle.astro';
import { getSite } from '@/lib/site';

const { servicios } = await getSite();
const iconosServicio = {
  gota: 'hidraulico',
  viento: 'neumatico',
  fabrica: 'fabrica',
  regla: 'medidas',
  // Sin equivalente en el set: manguera y fitting siguen en Phosphor duotono.
  flexible: 'ph:pipe-duotone',
  conexion: 'ph:pipe-wrench-duotone',
};
const fondosServicio = {
  gota: fondoHidraulico,
  viento: fondoNeumatico,
  fabrica: fondoProcesos,
  regla: fondoProyectos,
  flexible: fondoFlexibles,
  conexion: fondoAccesorios,
};
// Solo fotos reales de piezas fabricadas por el cliente (las de stock no se presentan como trabajo propio).
const fotos = [filtroAcero, filtroMalla];
const productos = servicios.galeria.items.map((item, i) => ({ ...item, foto: fotos[i] }));
---

<section id="servicios" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 md:px-10 md:py-28">
  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <SectionTitle antetitulo={servicios.antetitulo} titulo={servicios.titulo} />
    <p class="max-w-[46ch] text-lg leading-relaxed text-muted">{servicios.bajada}</p>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
    {
      servicios.items.map((item) => {
        const Icono = iconosServicio[item.icono];
        const propia = item.como === 'Fabricación propia';
        return (
          <li class="reveal">
            <article class="service-card group relative isolate flex h-full min-h-[23rem] flex-col overflow-clip rounded-2xl bg-ink p-7 text-white ring-1 ring-ink/10 transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-2xl hover:shadow-ink/25 md:p-8">
              <Image
                src={fondosServicio[item.icono]}
                alt=""
                widths={[400, 612]}
                sizes="(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="service-card__image absolute inset-0 -z-20 h-full w-full object-cover"
              />
              <span aria-hidden="true" class="service-card__shade absolute inset-0 -z-10" />
              <span
                aria-hidden="true"
                class="flex size-14 items-center justify-center rounded-2xl bg-white/12 text-white ring-1 ring-white/30 backdrop-blur-md transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:bg-[#7fd3ee] group-hover:text-ink group-hover:ring-[#7fd3ee]"
              >
                <Icon name={Icono} size={28} aria-hidden="true" class="icon-duo icon-duo--claro transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-rotate-6" />
              </span>
              <div class="mt-auto pt-16">
                <h3 class="max-w-[16ch] text-xl font-semibold leading-snug tracking-tight md:text-[1.35rem]">
                  {item.sistema}
                </h3>
                <p class="mt-3 leading-relaxed text-white/80">{item.asegura}</p>
                <p class="mt-6">
                  <span
                    class:list={[
                      'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-medium backdrop-blur-md',
                      propia ? 'bg-[#7fd3ee]/20 text-[#bdeaf8] ring-1 ring-[#7fd3ee]/45' : 'bg-white/8 text-white/90 ring-1 ring-white/30',
                    ]}
                  >
                    {propia && <span aria-hidden="true" class="size-1.5 rounded-full bg-[#7fd3ee]" />}
                    {item.como}
                  </span>
                </p>
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>

  <div class="reveal mt-20 md:mt-28">
    <SectionTitle antetitulo={servicios.galeria.antetitulo} titulo={servicios.galeria.titulo} nivel="h3" class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight" />
    <p class="mt-3 max-w-[52ch] text-lg leading-relaxed text-muted">{servicios.galeria.bajada}</p>
  </div>

  <div class="reveal mt-10">
    <div class="work-invite">
      <!-- Foto de ambientación (stock): decorativa, sin texto alternativo. -->
      <div class="work-invite__media" aria-hidden="true">
        <Picture
          src={fotoInvitacion}
          alt=""
          formats={['avif', 'webp']}
          widths={[480, 720, 1000, 1224]}
          sizes="(min-width: 1280px) 42rem, (min-width: 768px) 55vw, calc(100vw - 2.5rem)"
          loading="lazy"
          decoding="async"
          class="work-invite__img"
        />
      </div>
      <div class="work-invite__body">
        <p class="work-invite__title">{servicios.galeria.invitacion.titulo}</p>
        <p class="mt-4 leading-relaxed text-white/80">{servicios.galeria.invitacion.texto}</p>
        <a href="#contacto" class="work-invite__link mt-auto inline-flex items-center gap-2.5 pt-8 font-semibold">
          {servicios.galeria.invitacion.cta}
          <Icon name="ph:arrow-right" size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <ul class="work-grid mt-4 md:mt-6">
    {
      productos.map((producto) => (
        <li class="reveal">
          <figure class="work-card group m-0">
            <Image src={producto.foto} alt="" width={64} aria-hidden="true" loading="lazy" decoding="async" class="work-card__fill" />
            <Image
              src={producto.foto}
              alt={producto.alt}
              widths={[320, producto.foto.width]}
              sizes="(min-width: 1280px) 37rem, 50vw"
              loading="lazy"
              decoding="async"
              class="work-card__image"
            />
            <figcaption class="work-card__caption">
              <span class="work-card__title">{producto.titulo}</span>
              <span class="work-card__detail">{producto.detalle}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
