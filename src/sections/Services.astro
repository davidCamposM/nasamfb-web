---
import { Image } from 'astro:assets';
import { Cable, Droplets, Factory, PencilRuler, Unplug, Wind } from 'lucide-react';
import accesorios from '@/assets/products/accesorios-hidraulicos.jpg';
import filtroAcero from '@/assets/products/filtro-acero-perforado.jpg';
import filtroMalla from '@/assets/products/filtro-malla-metalica.jpg';
import conicos from '@/assets/products/filtros-conicos.jpg';
import flexibles from '@/assets/products/flexibles-hidraulicos.jpg';
import separadores from '@/assets/products/separadores-aire-aceite.jpg';
import fondoAccesorios from '@/assets/servicios/accesorios-hidraulicos.jpg';
import fondoFlexibles from '@/assets/servicios/flexibles-hidraulicos.jpg';
import fondoProcesos from '@/assets/servicios/procesos-industriales.jpg';
import fondoProyectos from '@/assets/servicios/proyectos-especiales.jpg';
import fondoHidraulico from '@/assets/servicios/sistema-hidraulico.jpg';
import fondoNeumatico from '@/assets/servicios/sistema-neumatico.jpg';
import { getSite } from '@/lib/site';

const { servicios } = await getSite();
const iconosServicio = {
  gota: Droplets,
  viento: Wind,
  fabrica: Factory,
  regla: PencilRuler,
  flexible: Cable,
  conexion: Unplug,
};
const fondosServicio = {
  gota: fondoHidraulico,
  viento: fondoNeumatico,
  fabrica: fondoProcesos,
  regla: fondoProyectos,
  flexible: fondoFlexibles,
  conexion: fondoAccesorios,
};
const fotos = [filtroAcero, filtroMalla, conicos, separadores, flexibles, accesorios];
const productos = servicios.galeria.items.map((item, i) => ({ ...item, foto: fotos[i] }));
---

<section id="servicios" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-20 md:px-10 md:py-28">
  <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
    <h2 class="display text-h2">{servicios.titulo}</h2>
    <p class="max-w-[46ch] text-lg leading-relaxed text-muted">{servicios.bajada}</p>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
    {
      servicios.items.map((item, i) => {
        const Icono = iconosServicio[item.icono];
        const propia = item.como === 'Fabricación propia';
        return (
          <li class="reveal">
            <article class="service-card group relative isolate flex h-full min-h-[23rem] flex-col overflow-clip rounded-2xl bg-ink p-7 text-white ring-1 ring-ink/10 transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-2xl hover:shadow-ink/25 md:p-8">
              <Image
                src={fondosServicio[item.icono]}
                alt=""
                widths={[400, 612]}
                sizes="(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="service-card__image absolute inset-0 -z-20 h-full w-full object-cover"
              />
              <span aria-hidden="true" class="service-card__shade absolute inset-0 -z-10" />
              <span
                aria-hidden="true"
                class="absolute right-6 top-5 font-serif text-5xl italic leading-none text-white/45 transition-colors duration-500 group-hover:text-[#7fd3ee]"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span
                aria-hidden="true"
                class="flex size-14 items-center justify-center rounded-2xl bg-white/12 text-white ring-1 ring-white/30 backdrop-blur-md transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:bg-[#7fd3ee] group-hover:text-ink group-hover:ring-[#7fd3ee]"
              >
                <Icono size={26} strokeWidth={1.6} className="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-rotate-6" />
              </span>
              <div class="mt-auto pt-16">
                <h3 class="max-w-[16ch] text-xl font-semibold leading-snug tracking-tight md:text-[1.35rem]">
                  {item.sistema}
                </h3>
                <p class="mt-3 leading-relaxed text-white/80">{item.asegura}</p>
                <p class="mt-6">
                  <span
                    class:list={[
                      'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm font-medium backdrop-blur-md',
                      propia ? 'bg-[#7fd3ee]/20 text-[#bdeaf8] ring-1 ring-[#7fd3ee]/45' : 'bg-white/8 text-white/90 ring-1 ring-white/30',
                    ]}
                  >
                    {propia && <span aria-hidden="true" class="size-1.5 rounded-full bg-[#7fd3ee]" />}
                    {item.como}
                  </span>
                </p>
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>

  <div class="reveal mt-16 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-2 md:mt-20">
    <h3 class="display text-2xl font-semibold tracking-tight md:text-3xl">{servicios.galeria.titulo}</h3>
    <p class="text-sm text-muted">{servicios.galeria.nota}</p>
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-3">
    {
      productos.map((producto) => (
        <li class="reveal">
          <figure class="group m-0">
            <div class="overflow-clip rounded-lg border border-border bg-surface">
              <Image
                src={producto.foto}
                alt={producto.alt}
                width={720}
                class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-3 text-sm font-medium text-muted">{producto.titulo}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
