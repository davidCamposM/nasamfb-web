---
import { Image, Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import cartuchosLiquidos from '@/assets/products/cartuchos-liquidos.jpg';
import cartuchos from '@/assets/products/cartuchos-plisados.jpg';
import elementos from '@/assets/products/elementos-filtrantes.jpg';
import filtroSaturado from '@/assets/products/filtro-saturado-vs-nuevo.jpg';
import aceite from '@/assets/products/filtros-aceite.jpg';
import aire from '@/assets/products/filtros-aire.jpg';
import recambios from '@/assets/products/filtros-combustible-aceite-cabina.jpg';
import plisadosCirculares from '@/assets/products/filtros-plisados-circulares.jpg';
import fotoProceso from '@/assets/products/mano-filtro-combustible.jpg';
import membranas from '@/assets/products/membranas-filtrantes.jpg';
import fotoReunion from '@/assets/products/reunion-sala-oficina.jpg';
import surtido from '@/assets/products/surtido-filtros.jpg';
import tecnico from '@/assets/products/tecnico-filtro-aceite.jpg';
import IconWhatsApp from '@/components/IconWhatsApp.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import { partes } from '@/lib/destacar';
import { getSite, whatsapp } from '@/lib/site';

const { nosotros, contacto } = await getSite();
// El manifiesto se compone por frases (cada una en su bloque) y palabras (cada una se ilumina al scroll).
// Una palabra puede mezclar partes destacadas y no destacadas: "**detiene**," → "detiene" + ",".
interface Palabra {
  piezas: ReturnType<typeof partes>;
  i: number;
}
let indicePalabra = 0;
const frases = (nosotros.manifiesto.match(/[^.!?]+[.!?]+/g) ?? [nosotros.manifiesto]).map((frase) => {
  const palabras: Palabra[] = [];
  let nueva = true;
  for (const parte of partes(frase.trim())) {
    parte.texto.split(' ').forEach((trozo, k) => {
      if (k > 0) nueva = true;
      if (trozo === '') return;
      if (nueva) {
        palabras.push({ piezas: [], i: indicePalabra++ });
        nueva = false;
      }
      palabras[palabras.length - 1].piezas.push({ texto: trozo, destacado: parte.destacado });
    });
  }
  return palabras;
});
// Íconos de contenido en duotono desde src/icons/; flechas e interfaz en Phosphor regular.
const iconos = { compas: 'diseno-medida', llave: 'mantencion', camion: 'logistica' };
const iconosProceso = ['inspeccion', 'ajuste', 'fabrica', 'rendimiento'];
// "Para comenzar, puede compartir": un plano, una muestra, las medidas (mismo orden que nosotros.consultas.insumos).
const iconosInsumo = ['plano', 'muestra', 'medidas'];
const iconosPregunta = {
  regla: 'medidas',
  sello: 'calidad',
  lista: 'cotizar',
  capas: 'capas',
  llave: 'mantencion',
  mapa: 'ubicacion',
};
const productos = [
  cartuchos,
  elementos,
  aire,
  filtroSaturado,
  membranas,
  aceite,
  surtido,
  cartuchosLiquidos,
  plisadosCirculares,
  recambios,
];
// Proporción del marco: 3:2. Las fotos más anchas o más altas se centran y funden sus bordes con el relleno.
const formato = (foto: ImageMetadata) => {
  const proporcion = foto.width / foto.height;
  if (proporcion > 1.65) return 'is-ancha';
  if (proporcion < 1.35) return 'is-alta';
  return '';
};
---

<section id="nosotros" class="scroll-mt-20 border-y border-border bg-surface">
  <div
    class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-24 md:px-10 md:pt-32 lg:grid-cols-12 lg:gap-16 xl:max-w-7xl"
  >
    <div class="text-center lg:col-span-6 lg:text-left xl:col-span-5">
      <h2 class="manifesto mx-auto max-w-[22ch] font-serif text-[clamp(2rem,6.2vw,2.75rem)] leading-[1.1] tracking-[-0.01em] lg:mx-0 lg:text-[clamp(2.15rem,3vw,3rem)]">
        {
          frases.map((frase) => (
            <span class="manifesto__frase">
              {frase.map((palabra) => (
                <span class="word" style={`--i: ${palabra.i}`}>
                  {palabra.piezas.map((pieza) =>
                    pieza.destacado ? <em class="manifesto__enfasis">{pieza.texto}</em> : pieza.texto,
                  )}{' '}
                </span>
              ))}
            </span>
          ))
        }
      </h2>

      <p class="reveal mx-auto mt-8 max-w-[40ch] text-lead leading-relaxed text-fg lg:mx-0">
        {partes(nosotros.intro).map((parte) => (parte.destacado ? <mark class="hl">{parte.texto}</mark> : parte.texto))}
      </p>

      <dl class="about-facts reveal mx-auto mt-10 max-w-[34rem] text-left lg:mx-0">
        <div class="about-facts__row">
          <dt>{nosotros.ficha.como.etiqueta}</dt>
          <dd>
            {partes(nosotros.ficha.como.valor).map((parte) =>
              parte.destacado ? <mark class="hl">{parte.texto}</mark> : parte.texto,
            )}
          </dd>
        </div>
        <div class="about-facts__row">
          <dt>{nosotros.ficha.donde}</dt>
          <dd>
            <ul class="flex flex-col gap-1">
              {nosotros.presencia.map((lugar) => (
                <li>
                  <span class="font-semibold">{lugar.ciudad}</span>
                  <span class="text-muted"> · {lugar.detalle}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
        <div class="about-facts__row">
          <dt>{nosotros.ficha.respaldo}</dt>
          <dd>
            <ul class="flex flex-col gap-0.5">
              {nosotros.clientes.map((nombre) => (
                <li class="font-serif text-[1.4rem] italic leading-snug">{nombre}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <figure class="filter-story m-0 w-full justify-self-center lg:col-span-6 xl:col-span-7">
      <Picture
        src={tecnico}
        alt={nosotros.foto.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 960, 1539]}
        sizes="(min-width: 1280px) 44rem, (min-width: 1024px) 48vw, (min-width: 768px) calc(100vw - 5rem), calc(100vw - 2.5rem)"
        class="filter-story__image"
      />
    </figure>
  </div>

  <!-- Pilares -->
  <ul class="mx-auto mt-16 grid max-w-6xl gap-10 px-5 text-center md:mt-20 md:grid-cols-3 md:gap-0 md:px-10">
    {
      nosotros.pilares.map((pilar, i) => {
        const Icono = iconos[pilar.icono];
        return (
          <li class="group reveal flex flex-col items-center px-6 md:border-l md:border-border md:first:border-l-0" style={`--i: ${i}`}>
            <span
              aria-hidden="true"
              class="mb-5 flex size-14 items-center justify-center rounded-2xl bg-brand/10 text-accent ring-1 ring-brand/20 transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:-translate-y-1 group-hover:bg-accent group-hover:text-on-accent group-hover:ring-accent"
            >
              <Icon name={Icono} size={28} aria-hidden="true" class="icon-duo transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-rotate-6" />
            </span>
            <h3 class="text-xl font-semibold tracking-tight">{pilar.titulo}</h3>
            <p class="mx-auto mt-2 max-w-[30ch] leading-relaxed text-muted">{pilar.texto}</p>
          </li>
        );
      })
    }
  </ul>

  <section class="about-process mx-auto mt-24 grid max-w-6xl gap-10 px-5 md:mt-32 md:px-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14 xl:grid-cols-[2fr_1fr] xl:gap-14" aria-labelledby="proceso-titulo">
    <div class="about-process__intro lg:sticky lg:top-28 lg:self-start">
      <SectionTitle antetitulo={nosotros.proceso.antetitulo} titulo={nosotros.proceso.titulo} id="proceso-titulo" />
      <p class="mt-6 max-w-[45ch] text-lg leading-relaxed text-muted">{nosotros.proceso.descripcion}</p>
      <figure class="process-visual mt-10">
        <Picture
          src={fotoProceso}
          alt={nosotros.proceso.fotoAlt}
          formats={['avif', 'webp']}
          widths={[480, 800, 1100, 1400]}
          sizes="(min-width: 1280px) 46rem, (min-width: 1024px) 56vw, calc(100vw - 2.5rem)"
          loading="lazy"
          decoding="async"
          class="process-visual__img"
        />
      </figure>
    </div>
    <ol class="process-steps">
      {nosotros.proceso.pasos.map((paso, i) => {
        const Icono = iconosProceso[i];
        return (
          <li class="process-step">
            <span class="process-step__marker" aria-hidden="true">
              <Icon name={Icono} size={26} aria-hidden="true" class="icon-duo process-step__icon" />
              <span class="process-step__number">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <div>
              <h3 class="text-xl font-semibold tracking-tight md:text-2xl">{paso.titulo}</h3>
              <p class="mt-3 max-w-[58ch] leading-relaxed text-muted">{paso.texto}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <div class="about-proof mx-auto mt-20 max-w-4xl px-5 md:mt-24 md:px-10">
    <section class="product-gallery" data-product-gallery data-gallery-loading={nosotros.galeria.cargando} data-gallery-error={nosotros.galeria.error} aria-labelledby="galeria-titulo">
      <div class="mb-8 md:mb-10">
        <SectionTitle antetitulo={nosotros.galeria.antetitulo} titulo={nosotros.galeria.titulo} id="galeria-titulo" />
        <p class="mt-3 max-w-[52ch] text-lg leading-relaxed text-muted">{nosotros.galeria.bajada}</p>
      </div>
      <div class="product-gallery__panels">
        {productos.map((producto, i) => (
          <figure class="product-gallery__panel" id={`producto-${i}`} data-gallery-panel>
            <div class:list={['product-gallery__frame', formato(producto)]}>
              <Image src={producto} alt="" width={160} height={104} fit="cover" aria-hidden="true" class="product-gallery__fill" />
              <Picture src={producto} alt={nosotros.galeria.items[i].alt} formats={['avif', 'webp']} widths={[400, 640, 960]} sizes="(min-width: 1024px) 52rem, calc(100vw - 2.5rem)" class="product-gallery__image" />
            </div>
            <figcaption class="gallery-caption">
              <span class="gallery-caption__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
                <span>/ {String(productos.length).padStart(2, '0')}</span>
              </span>
              <span class="gallery-caption__texto">
                <span class="gallery-caption__titulo">{nosotros.galeria.items[i].titulo}</span>
                <span class="gallery-caption__detalle">{nosotros.galeria.items[i].detalle}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="product-gallery__controls" data-gallery-controls hidden>
        <div class="mt-5 flex items-center justify-between gap-3">
          <p class="sr-only" data-gallery-status aria-live="polite" aria-atomic="true"></p>
          <div class="flex gap-2">
            <button type="button" data-gallery-prev class="gallery-arrow" aria-label={nosotros.galeria.anterior}><Icon name="ph:arrow-left" size={20} aria-hidden="true" /></button>
            <button type="button" data-gallery-next class="gallery-arrow" aria-label={nosotros.galeria.siguiente}><Icon name="ph:arrow-right" size={20} aria-hidden="true" /></button>
          </div>
        </div>
        <div class="product-gallery__thumbs" role="group" aria-label={nosotros.galeria.etiqueta}>
          {productos.map((producto, i) => (
            <button type="button" data-gallery-thumb aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`producto-${i}`} aria-label={nosotros.galeria.items[i].titulo} class="gallery-thumb">
              <Image src={producto} alt="" width={160} height={104} fit="cover" class="h-full w-full object-cover" />
            </button>
          ))}
        </div>
      </div>
    </section>
  </div>

  <section class="about-consultas mt-24 bg-bg md:mt-32" aria-labelledby="consultas-titulo">
    <div class="about-consultas__band">
      <div class="about-consultas__backdrop" aria-hidden="true">
        <Picture
          src={fotoReunion}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[768, 1280, 1536]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
          class="about-consultas__backdrop-image"
        />
      </div>
      <div class="about-consultas__content relative mx-auto max-w-7xl px-5 pb-20 md:px-10 md:pb-28">
      <div class="grid items-stretch gap-5 lg:grid-cols-[0.88fr_1.12fr] lg:gap-8">
        <div class="about-consultas__intro flex flex-col rounded-2xl px-7 py-9 text-white sm:px-10 sm:py-12 lg:px-12 lg:py-14">
          <h2 id="consultas-titulo" class="display max-w-[12ch] text-h2">{nosotros.consultas.titulo}</h2>
          <p class="mt-7 max-w-[39ch] text-lg leading-relaxed text-white/80">{nosotros.consultas.cierre}</p>
          <a href="#contacto" class="btn mt-9 w-fit bg-[#7fd3ee] text-ink hover:bg-white">
            {nosotros.consultas.cta}<Icon name="ph:arrow-right" size={18} aria-hidden="true" />
          </a>
          <div class="mt-auto pt-12">
            <p class="border-t border-white/20 pt-6 text-sm font-medium text-white/75">{nosotros.consultas.inicio}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={nosotros.consultas.inicio}>
              {nosotros.consultas.insumos.map((insumo, i) => (
                <li class="insumo-chip">
                  <Icon name={iconosInsumo[i] ?? 'medidas'} size={18} aria-hidden="true" class="icon-duo icon-duo--claro" />
                  {insumo}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="about-consultas__faq flex flex-col rounded-2xl px-6 py-8 sm:px-9 sm:py-10 lg:px-12 lg:py-12">
          <h3 class="mb-6 text-xl font-semibold tracking-tight md:text-2xl">{nosotros.consultas.preguntasTitulo}</h3>
          <div class="about-questions">
            {nosotros.consultas.items.map((item, i) => {
              const Icono = iconosPregunta[item.icono];
              return (
                <details class="about-question" name="consultas-nosotros" open={i === 0}>
                  <summary>
                    <span class="flex min-w-0 items-center gap-4">
                      <span
                        aria-hidden="true"
                        class="about-question__icon flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-accent ring-1 ring-brand/20"
                      >
                        <Icon name={Icono} size={21} aria-hidden="true" class="icon-duo" />
                      </span>
                      <span class="text-lg font-semibold">{item.pregunta}</span>
                    </span>
                    <span aria-hidden="true" class="about-question__indicator" />
                  </summary>
                  <p class="max-w-[62ch] pb-7 pl-14 pr-8 leading-relaxed text-muted">{item.respuesta}</p>
                </details>
              );
            })}
          </div>
          <p class="mt-auto pt-10 text-sm leading-relaxed text-muted">
            {nosotros.consultas.otraPregunta}
            <a href="#contacto" class="ml-1 font-semibold text-accent underline decoration-current/40 underline-offset-4 hover:decoration-current">{nosotros.consultas.otraPreguntaCta}</a>
          </p>
        </div>
      </div>

      <div class="about-consultas__contact mt-5 grid gap-6 rounded-2xl px-6 py-7 sm:px-9 md:grid-cols-[0.8fr_1fr_1fr] md:gap-10 lg:mt-8 lg:px-12 lg:py-9">
        <div>
          <p class="text-xl font-semibold tracking-tight">{nosotros.consultas.contactoTitulo}</p>
          <p class="mt-2 max-w-[25ch] text-sm leading-relaxed text-muted">{nosotros.consultas.contactoTexto}</p>
        </div>
        {contacto.personas.map((persona) => (
          <div class="border-t border-border pt-5 md:border-t-0 md:border-l md:py-1 md:pl-7">
            <p class="text-sm font-medium text-accent">{persona.ciudad}</p>
            <p class="mt-2 font-semibold">{persona.nombre}</p>
            <a href={whatsapp(persona.telefono, contacto.mensajeWhatsapp)} target="_blank" rel="noopener" class="about-consultas__whatsapp mt-3 inline-flex min-h-11 items-center gap-2.5 font-semibold text-fg" aria-label={`Escribir por WhatsApp a ${persona.nombre}, ${persona.telefono}`}>
              <span class="wa-chip flex size-9 items-center justify-center rounded-full bg-[#25d366] text-white" aria-hidden="true">
                <IconWhatsApp size={19} />
              </span>
              WhatsApp <Icon name="ph:arrow-up-right" size={17} aria-hidden="true" />
            </a>
            {contacto.email && (
              <a href={`mailto:${contacto.email}`} class="link-line mt-2 flex w-fit items-center gap-2 pb-0.5 text-sm text-muted hover:text-accent" aria-label={`${contacto.correo}: ${contacto.email}`}>
                <Icon name="gmail" size={15} aria-hidden="true" />
                {contacto.email}
              </a>
            )}
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>
</section>

<script>
  const bindGalleries = () => {
    for (const gallery of document.querySelectorAll<HTMLElement>('[data-product-gallery]')) {
      if (gallery.dataset.enhanced) continue;
      const panels = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-panel]')];
      const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
      const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]');
      const status = gallery.querySelector<HTMLElement>('[data-gallery-status]');
      if (!controls || !status || panels.length !== thumbs.length || panels.length === 0) continue;
      let current = 0;
      let requested = 0;
      let requestVersion = 0;
      // Fotos descargadas y decodificadas: se muestran sin espera. Las demás se precargan en segundo plano.
      // La foto principal, no la miniatura difuminada de relleno (.product-gallery__fill), que va primero.
      const images = panels.map((panel) => panel.querySelector<HTMLImageElement>('img.product-gallery__image'));
      const ready = new WeakSet<HTMLImageElement>();
      const pending = new WeakMap<HTMLImageElement, Promise<void>>();
      const preload = (image: HTMLImageElement | null): Promise<void> => {
        if (!image || ready.has(image)) return Promise.resolve();
        const existing = pending.get(image);
        if (existing) return existing;
        image.loading = 'eager';
        const promise = image.decode().then(
          () => {
            ready.add(image);
          },
          (error: unknown) => {
            pending.delete(image);
            throw error;
          },
        );
        pending.set(image, promise);
        return promise;
      };
      const preloadAll = async () => {
        for (const image of images) await preload(image).catch(() => undefined);
      };
      const show = async (index: number, animate = true) => {
        const next = (index + panels.length) % panels.length;
        requested = next;
        const version = ++requestVersion;
        const image = images[next];
        if (animate && image && !ready.has(image)) {
          gallery.setAttribute('aria-busy', 'true');
          status.textContent = `${gallery.dataset.galleryLoading} · ${thumbs[next].getAttribute('aria-label')}`;
          try {
            await preload(image);
          } catch {
            if (version !== requestVersion) return;
            gallery.setAttribute('aria-busy', 'false');
            status.textContent = gallery.dataset.galleryError ?? '';
            requested = current;
            return;
          }
          if (version !== requestVersion) return;
        }
        gallery.setAttribute('aria-busy', 'false');
        for (const [i, panel] of panels.entries()) {
          panel.getAnimations().forEach((animation) => animation.cancel());
          panel.hidden = i !== next;
          thumbs[i].setAttribute('aria-pressed', String(i === next));
        }
        current = next;
        status.textContent = `${next + 1} / ${panels.length} · ${thumbs[next].getAttribute('aria-label')}`;
        if (animate && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          panels[next].animate([{ opacity: 0.4, transform: 'scale(1.012)' }, { opacity: 1, transform: 'none' }], {
            duration: 320,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          });
        }
      };
      gallery.dataset.enhanced = 'true';
      controls.hidden = false;
      void show(0, false);
      if (images[0]?.complete) ready.add(images[0]);
      // Precarga al acercarse la galería a la pantalla, para que cambiar de foto sea inmediato.
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void preloadAll();
        },
        { rootMargin: '800px 0px' },
      );
      observer.observe(gallery);
      const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
      const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
      const warm = (offset: number) => () => {
        void preload(images[(requested + offset + images.length) % images.length]).catch(() => undefined);
      };
      thumbs.forEach((thumb, i) => {
        thumb.onclick = () => {
          if (i !== requested) void show(i);
        };
        thumb.onpointerenter = thumb.onfocus = () => {
          void preload(images[i]).catch(() => undefined);
        };
      });
      prev.onclick = () => {
        void show(requested - 1);
      };
      next.onclick = () => {
        void show(requested + 1);
      };
      prev.onpointerenter = prev.onfocus = warm(-1);
      next.onpointerenter = next.onfocus = warm(1);
      controls.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        void show(requested + (event.key === 'ArrowRight' ? 1 : -1));
      });
    }
  };
  bindGalleries();
  document.addEventListener('astro:after-swap', bindGalleries);
</script>
