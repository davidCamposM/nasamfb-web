---
import { getSite } from '@/lib/site';

const { cifras } = await getSite();
---

<section class="px-6 py-32" aria-label="Cifras">
  <dl class="mx-auto grid max-w-7xl gap-12 sm:grid-cols-3">
    {
      cifras.map((c) => (
        <div class="reveal">
          <dt class="text-sm text-muted">{c.etiqueta}</dt>
          <dd class="mt-2 font-display text-h1 font-semibold tracking-tighter tabular-nums">{c.valor}</dd>
        </div>
      ))
    }
  </dl>
</section>
