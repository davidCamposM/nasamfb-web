---
import { Image, Picture } from 'astro:assets';
import armada from '@/assets/clients/armada.png';
import asmar from '@/assets/clients/asmar.png';
import planta from '@/assets/hero/planta-industrial.jpg';
import { getSite } from '@/lib/site';

const { hero, nosotros } = await getSite();
const clientes = [
  { nombre: nosotros.clientes[0], logo: armada },
  { nombre: nosotros.clientes[1], logo: asmar },
];
---

<section class="hero relative isolate overflow-clip bg-ink text-white">
  <!-- Fondo: foto + capas para legibilidad -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <Picture
      src={planta}
      alt=""
      formats={['avif', 'webp']}
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-bg h-full w-full object-cover object-[30%_center]"
    />
    <div class="absolute inset-0 bg-ink/60"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgb(14_26_38/0.55),transparent_70%)]"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink/70 to-transparent"></div>
  </div>

  <div
    class="mx-auto flex min-h-[calc(100dvh-5rem)] max-w-5xl flex-col items-center justify-center px-5 py-16 text-center md:px-10 md:py-20"
  >
    <h1 class="display intro mx-auto max-w-[15ch] text-display text-balance" style="--i: 1">{hero.titulo}</h1>
    <p class="intro mx-auto mt-7 max-w-[58ch] text-lead leading-relaxed text-white/85" style="--i: 2">
      {hero.bajada}
    </p>
    <div class="intro mt-9 flex flex-wrap justify-center gap-3" style="--i: 3">
      <a href="#contacto" class="btn bg-[#5cc8ea] text-ink hover:bg-white">{hero.ctaPrincipal}</a>
      <a href="#servicios" class="btn border-[1.5px] border-white/80 text-white hover:bg-white hover:text-ink">
        {hero.ctaSecundario}
      </a>
    </div>

    <div class="intro mt-12 flex flex-col items-center gap-3 md:mt-14" style="--i: 5">
      <span aria-hidden="true" class="h-8 w-px bg-white/40"></span>
      <p class="text-sm text-white/75">{hero.respaldo}</p>
      <ul class="mt-2 grid grid-cols-2 gap-4 sm:gap-8">
        {clientes.map((cliente) => (
          <li class="flex min-w-0 flex-col items-center gap-3">
            <span class="flex min-h-12 items-end text-center font-serif text-xl leading-tight sm:text-2xl md:text-[1.75rem]">
              {cliente.nombre}
            </span>
            <span class="flex h-28 w-36 items-center justify-center rounded-xl bg-white p-3 sm:w-40" aria-hidden="true">
              <Image src={cliente.logo} alt="" width={128} height={96} fit="contain" class="h-full w-full object-contain" />
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
