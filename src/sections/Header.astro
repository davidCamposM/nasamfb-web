---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { getSite } from '@/lib/site';

const site = await getSite();
const links = [
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-40 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5" aria-label="Principal">
    <a href="/" class="font-display text-lg font-medium tracking-tight">{site.nombre}</a>
    <div class="flex items-center gap-8">
      <ul class="hidden gap-8 text-sm text-muted md:flex">
        {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-fg">{l.label}</a></li>)}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
