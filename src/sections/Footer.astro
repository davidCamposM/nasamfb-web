---
import { getSite } from '@/lib/site';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="bg-ink text-sm text-[#a9b8c5]">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 border-t border-white/10 px-5 py-8 md:px-10">
    <p>© {year} {site.nombre}</p>
    <p>{site.nosotros.presencia.map((p) => p.ciudad).join(' y ')}, Chile</p>
  </div>
</footer>
