---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <main id="contenido" class="flex min-h-dvh flex-col items-start justify-center px-6">
    <div class="mx-auto w-full max-w-7xl">
      <p class="text-sm text-muted">Error 404</p>
      <h1 class="mt-4 font-display text-h1 font-semibold tracking-tighter">Esta página no existe.</h1>
      <a href="/" class="mt-8 inline-block underline underline-offset-4 hover:text-accent">Volver al inicio</a>
    </div>
  </main>
</BaseLayout>
